@@ -0,0 +1,27 @@
+// Statische Pruefungen ohne App-Start: Hausregeln fuer Oberflaeche und Doku.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'fs';
+import path from 'path';
+import { ROOT } from './helpers.mjs';
+
+const read = (f) => fs.readFileSync(path.join(ROOT, f), 'utf8');
+
+test('Keine Emojis in Oberflaeche, Code und Dokumentation', () => {
+  const emoji = /[\p{Emoji_Presentation}️]/u;
+  for (const f of ['app/index.html', 'app/privacy-shield.html', 'main.js', 'preload.js', 'README.md', 'CHANGELOG.md', 'THIRD_PARTY_NOTICES.md']) {
+    if (!fs.existsSync(path.join(ROOT, f))) continue;
+    const m = read(f).match(emoji);
+    assert.equal(m, null, `${f} enthaelt ein Emoji (${m && m[0]}); stattdessen SVG oder Text verwenden`);
+  }
+});
+
+test('Texte der Shell haben korrekte Umlaute', () => {
+  const s = read('app/index.html');
+  for (const bad of ['Spater', 'verfugbar', 'durchgefuhrt', 'schliessen', 'Schliessen', ' lauft']) assert.ok(!s.includes(bad), `Shell enthaelt "${bad}"`);
+});
+
+test('Das Tool spricht in der Desktop-App nicht von Browser-Tab', () => {
+  const s = read('app/privacy-shield.html');
+  for (const bad of ['Schließen des Tabs', 'Ihres Browsers', 'dein Browser', 'lokal im Browser', 'Empfohlen am PC']) assert.ok(!s.includes(bad), `Tool enthaelt "${bad}"`);
+});
diff --git a/tests/shell.test.mjs b/tests/shell.test.mjs
new file mode 100644
index 0000000..08ebb3e
--- /dev/null
+++ b/tests/shell.test.mjs
@@ -0,0 +1,28 @@
+// Shell der Desktop-App: Diagnose und Anordnung der Bedienelemente.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { launchApp, toolFrame } from './helpers.mjs';
+
+test('Diagnose kopieren legt technische Angaben (ohne Dokumentinhalte) in die Zwischenablage', async () => {
+  const a = await launchApp({ offline: true });
+  try {
+    const f = await toolFrame(a.win);
+    await f.evaluate(() => { document.getElementById('IT').value = 'Vertraulicher Text von Thomas Müller'; });
+    await a.win.click('#btn-diag');
+    await a.win.waitForTimeout(800);
+    const text = await a.app.evaluate(({ clipboard }) => clipboard.readText());
+    assert.match(text, /^PrivacyShield \d+\.\d+\.\d+/);
+    assert.match(text, /KI-Modus: auto/);
+    assert.match(text, /Cross-Origin-Isolation: true/);
+    assert.doesNotMatch(text, /Müller|Vertraulich/);
+  } finally { await a.close(); }
+});
+
+test('Versions- und Update-Leiste liegt unten und verdeckt die Navigation des Tools nicht', async () => {
+  const a = await launchApp({ offline: true });
+  try {
+    await toolFrame(a.win);
+    const box = await a.win.evaluate(() => { const r = document.getElementById('update-check-btn').getBoundingClientRect(); return { top: r.top, height: innerHeight }; });
+    assert.ok(box.top > box.height / 2, 'Leiste muss in der unteren Haelfte liegen');
+  } finally { await a.close(); }
+});
